[package]
name = "{doido_ext_name}"
description = "Doido extension — {doido_ext_pascal} generators and integration hooks."
version = "0.1.0"
edition = "2021"
license = "MIT OR Apache-2.0"

[dependencies]
doido-core = {doido_core_dep}
doido-controller = {doido_controller_dep}
doido = {doido_dep}

[features]
default = ["generators"]
generators = []

[dev-dependencies]
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
