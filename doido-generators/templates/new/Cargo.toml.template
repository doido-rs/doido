[package]
name = "{doido_name}"
description = "Starter Doido web application: Axum server, routed hello endpoint, templating scaffolding."
version = "0.1.0"
edition = "2021"
# Default binary when running `cargo run` from the app root.
# Equivalent to `cargo run --bin {doido_name}` / `cargo doido`.
default-run = "{doido_name}"

# Migrations live in `db/migration/mod.rs` and are compiled into this binary.
# `doido db migrate` runs the `Migrator` in-process (registered via `.migrator`
# in `src/main.rs`).

# Standalone workspace root so the app can live inside another checkout
# (e.g. `target/e2e/apps/`) without joining that parent workspace.
[workspace]

[dependencies]
doido = {doido_dep}
doido-core = {doido_core_dep}
doido-controller = {doido_controller_dep}
doido-model = {doido_model_dep}
doido-jobs = {doido_jobs_dep}
doido-mailer = {doido_mailer_dep}
{doido_cable_deps}{doido_auth_deps}async-trait = "0.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sqlx = { version = "0.8", features = ["runtime-tokio", "{doido_sqlx_feature}"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }

# Release profile tuned for production deploys (Dockerfile runs `cargo build --release`).
[profile.release]
lto = "thin"
codegen-units = 1
strip = true

[dev-dependencies]
# Used by generated scaffold controller request tests (Router::oneshot).
tower = { version = "0.5", features = ["util"] }
