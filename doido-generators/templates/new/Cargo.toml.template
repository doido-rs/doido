[package]
name = "{doido_name}"
description = "Starter Doido web application: Axum server, routed hello endpoint, templating scaffolding."
version = "0.1.0"
edition = "2021"
# Default binary when running `cargo run` from the app root (workspace also has
# `db/migration`). Equivalent to `cargo run --bin {doido_name}` / `cargo doido`.
default-run = "{doido_name}"

# The SeaORM migration project lives in `db/migration` and is built as part of
# this workspace.
[workspace]
members = ["db/migration", "db/seed"]

[dependencies]
doido = {doido_dep}
doido-core = {doido_core_dep}
doido-controller = {doido_controller_dep}
doido-model = {doido_model_dep}
doido-jobs = {doido_jobs_dep}
doido-mailer = {doido_mailer_dep}
{doido_cable_deps}{doido_auth_deps}serde = { version = "1", features = ["derive"] }
serde_json = "1"
sqlx = { version = "0.8", features = ["runtime-tokio", "{doido_sqlx_feature}"] }
tokio = { version = "1", features = ["full"] }

[dev-dependencies]
# Used by generated scaffold controller request tests (Router::oneshot).
tower = { version = "0.5", features = ["util"] }
