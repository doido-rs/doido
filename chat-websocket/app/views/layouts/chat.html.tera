<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ title }}{% endblock %} · Chat</title>
  <link rel="stylesheet" href="/assets/css/chat.css">
  {% block head %}{% endblock %}
</head>
<body>
  <div class="app-shell">
    {% block body %}{% endblock %}
  </div>
  {% block scripts %}{% endblock %}
</body>
</html>
