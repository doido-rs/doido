{% extends "layouts/application.html.tera" %}
{% block content %}
<section>
  <h1 class="text-3xl font-bold text-white">{{ title }}</h1>
  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-900/50 text-slate-400">
          <th class="px-4 py-3">{{ labels.id }}</th>
          <th class="px-4 py-3">{{ labels.user_id }}</th>
          <th class="px-4 py-3">{{ labels.company_id }}</th>
          <th class="px-4 py-3">{{ labels.role }}</th>
          <th class="px-4 py-3">{{ labels.salary }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="border-b border-slate-900 hover:bg-slate-900/40">
          <td class="px-4 py-3">{{ row.id }}</td>
          <td class="px-4 py-3">{{ row.user_id }}</td>
          <td class="px-4 py-3">{{ row.company_id }}</td>
          <td class="px-4 py-3">{{ row.role }}</td>
          <td class="px-4 py-3">{{ row.salary | default(value="—") }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5" class="px-4 py-6 text-slate-500">—</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% include "layouts/_paginator.html.tera" %}
</section>
{% endblock %}
