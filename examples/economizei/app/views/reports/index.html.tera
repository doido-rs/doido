{% extends "layouts/application.html.tera" %}
{% block content %}
<section>
  <h1 class="text-3xl font-bold text-white">{{ title }}</h1>
  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
    <article class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <h2 class="text-sm font-bold text-accent">{{ labels.balance_chart | default(value="Income allocation") }}</h2>
      <p class="mt-1 text-xs text-slate-400">
        {{ labels.savings_rate | default(value="Savings rate") }}: {{ report.health.savings_rate }} ·
        {{ labels.expense_ratio | default(value="Expense ratio") }}: {{ report.health.expense_ratio }}
      </p>
      <div class="mt-3 aspect-square w-full">
        <canvas id="balance-chart" aria-label="{{ labels.balance_chart }}"></canvas>
      </div>
    </article>
    <article class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <h2 class="text-sm font-bold text-accent">{{ labels.savings_split | default(value="Salary allocation") }}</h2>
      <p class="mt-1 text-xs text-slate-400">
        {{ labels.savings_rate | default(value="Savings rate") }}: {{ report.spending_goals.savings_target_rate }}
      </p>
      <div class="mt-3 aspect-square w-full">
        <canvas id="savings-split-chart" aria-label="{{ labels.savings_split }}"></canvas>
      </div>
    </article>
    <article class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <h2 class="text-sm font-bold text-accent">{{ labels.expenses_by_category | default(value="Expenses by category") }}</h2>
      <div class="mt-3 aspect-square w-full">
        <canvas id="expenses-chart" aria-label="{{ labels.expenses_by_category }}"></canvas>
      </div>
    </article>
    <article class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <h2 class="text-sm font-bold text-accent">{{ labels.budget_by_category | default(value="Budget by category") }}</h2>
      <div class="mt-3 aspect-square w-full">
        <canvas id="budget-chart" aria-label="{{ labels.budget_by_category }}"></canvas>
      </div>
    </article>
  </div>
  <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <dt class="text-xs uppercase tracking-widest text-slate-500">{{ labels.total_income | default(value="Total income") }}</dt>
      <dd class="mt-2 text-xl font-bold text-white">{{ report.health.total_income }}</dd>
    </div>
    <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <dt class="text-xs uppercase tracking-widest text-slate-500">{{ labels.total_expenses | default(value="Total expenses") }}</dt>
      <dd class="mt-2 text-xl font-bold text-white">{{ report.health.total_expenses }}</dd>
    </div>
    <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <dt class="text-xs uppercase tracking-widest text-slate-500">{{ labels.savings_rate | default(value="Savings rate") }}</dt>
      <dd class="mt-2 text-xl font-bold text-accent">{{ report.health.savings_rate }}</dd>
    </div>
    <div class="rounded-xl border border-slate-800 bg-slate-900 p-4">
      <dt class="text-xs uppercase tracking-widest text-slate-500">{{ labels.expense_ratio | default(value="Expense ratio") }}</dt>
      <dd class="mt-2 text-xl font-bold text-accent">{{ report.health.expense_ratio }}</dd>
    </div>
  </dl>
</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
  const report = {{ report_script | safe }};
  const palette = ["#14b8a6", "#38bdf8", "#a78bfa", "#f472b6", "#fbbf24", "#34d399", "#fb7185", "#818cf8"];

  function pieChart(canvasId, slices) {
    const el = document.getElementById(canvasId);
    if (!el || !window.Chart) return;
    new Chart(el, {
      type: "pie",
      data: {
        labels: slices.map((s) => s.label),
        datasets: [{
          data: slices.map((s) => s.value),
          backgroundColor: slices.map((_, i) => palette[i % palette.length]),
          borderColor: "#0f172a",
          borderWidth: 2,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom",
            labels: {
              color: "#cbd5e1",
              font: { family: "Ubuntu Mono", size: 10 },
              boxWidth: 10,
            },
          },
        },
      },
    });
  }

  pieChart("balance-chart", report.charts.balance);
  pieChart("savings-split-chart", report.charts.savings_split);
  pieChart("expenses-chart", report.charts.expenses_by_category);
  pieChart("budget-chart", report.charts.budget_by_category);
</script>
{% endblock %}
