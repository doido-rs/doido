{% extends "layouts/application.html.tera" %}
{% block content %}
<section>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-white">{{ title }}</h1>
    <a href="/bank_accounts/new" class="rounded-lg bg-accent px-4 py-2 text-sm font-bold text-slate-950 hover:opacity-90">{{ nav.new_account | default(value="New account") }}</a>
    <a href="/bank_statement_imports/new" class="rounded-lg border border-slate-700 px-4 py-2 text-sm hover:bg-slate-900">{{ nav.import_statement | default(value="Import CSV") }}</a>
  </div>
  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-900/50 text-slate-400">
          <th class="px-4 py-3">{{ labels.id }}</th>
          <th class="px-4 py-3">{{ labels.bank_id }}</th>
          <th class="px-4 py-3">{{ labels.agency }}</th>
          <th class="px-4 py-3">{{ labels.account_number }}</th>
          <th class="px-4 py-3">{{ labels.cpf_cnpj }}</th>
          <th class="px-4 py-3">{{ labels.account_type }}</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="border-b border-slate-900 hover:bg-slate-900/40">
          <td class="px-4 py-3"><a href="/bank_accounts/{{ row.id }}" class="text-accent hover:underline">{{ row.id }}</a></td>
          <td class="px-4 py-3">{% set link = row.bank %}{% include "layouts/_association_cell.html.tera" %}</td>
          <td class="px-4 py-3">{{ row.agency }}</td>
          <td class="px-4 py-3">{{ row.account_number }}</td>
          <td class="px-4 py-3">{{ row.cpf_cnpj }}</td>
          <td class="px-4 py-3">{{ row.account_type }}</td>
          <td class="px-4 py-3 space-x-3">
            <a href="/bank_accounts/{{ row.id }}" class="text-accent hover:underline">{{ nav.view | default(value="View") }}</a>
            <a href="/bank_accounts/{{ row.id }}/edit" class="text-accent hover:underline">{{ nav.edit | default(value="Edit") }}</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" class="px-4 py-6 text-slate-500">—</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% include "layouts/_paginator.html.tera" %}
</section>
{% endblock %}
