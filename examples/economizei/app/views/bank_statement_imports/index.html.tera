{% extends "layouts/application.html.tera" %}
{% block content %}
<section>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-white">{{ title }}</h1>
    <a href="/bank_statement_imports/new" class="rounded-lg bg-accent px-4 py-2 text-sm font-bold text-slate-950 hover:opacity-90">{{ nav.import_statement | default(value="Import CSV") }}</a>
  </div>
  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-800">
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-900/50 text-slate-400">
          <th class="px-4 py-3">{{ labels.id }}</th>
          <th class="px-4 py-3">{{ labels.bank_account_id }}</th>
          <th class="px-4 py-3">{{ labels.source }}</th>
          <th class="px-4 py-3">{{ labels.statement_type }}</th>
          <th class="px-4 py-3">{{ labels.original_filename }}</th>
          <th class="px-4 py-3">{{ labels.transactions_imported }}</th>
          <th class="px-4 py-3">{{ labels.status }}</th>
          <th class="px-4 py-3">{{ labels.created_at }}</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="border-b border-slate-900 hover:bg-slate-900/40">
          <td class="px-4 py-3"><a href="/bank_statement_imports/{{ row.id }}" class="text-accent hover:underline">{{ row.id }}</a></td>
          <td class="px-4 py-3">{% set link = row.bank_account %}{% include "layouts/_association_cell.html.tera" %}</td>
          <td class="px-4 py-3">{{ row.source }}</td>
          <td class="px-4 py-3">{{ row.statement_type }}</td>
          <td class="px-4 py-3">{{ row.original_filename }}</td>
          <td class="px-4 py-3">{{ row.transactions_imported }}</td>
          <td class="px-4 py-3">{{ row.status }}</td>
          <td class="px-4 py-3">{{ row.created_at }}</td>
          <td class="px-4 py-3"><a href="/bank_statement_imports/{{ row.id }}" class="text-accent hover:underline">{{ nav.view | default(value="View") }}</a></td>
        </tr>
        {% else %}
        <tr>
          <td colspan="9" class="px-4 py-6 text-slate-500">—</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% include "layouts/_paginator.html.tera" %}
</section>
{% endblock %}
