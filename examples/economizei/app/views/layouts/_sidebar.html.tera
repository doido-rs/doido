<aside class="hidden md:flex w-64 shrink-0 flex-col border-r border-slate-800 bg-sidebar text-slate-200">
  <div class="border-b border-slate-800 px-6 py-5">
    <p class="text-lg font-bold tracking-tight text-accent">{{ app_name | default(value="economizei") }}</p>
    <p class="text-xs text-slate-400">financial balance</p>
  </div>
  <nav class="flex flex-1 flex-col gap-1 p-4 text-sm">
    <a href="/" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.dashboard | default(value="Dashboard") }}</a>
    <a href="/bank_accounts" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.accounts | default(value="Bank accounts") }}</a>
    <a href="/bank_statement_imports" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.import_statement | default(value="Import CSV") }}</a>
    {% if transactions_path %}
    <a href="{{ transactions_path }}" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.transactions | default(value="Transactions") }}</a>
    <a href="{{ categories_path }}" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.categories | default(value="Categories") }}</a>
    <a href="{{ counterparties_path }}" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.counterparties | default(value="Counterparties") }}</a>
    <a href="/members" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.company_users | default(value="Company users") }}</a>
    <a href="/reports" class="rounded-lg px-3 py-2 hover:bg-sidebar-hover">{{ nav.reports | default(value="Reports") }}</a>
    {% endif %}
  </nav>
  <div class="border-t border-slate-800 p-4">
    <form method="post" action="/users/sign_out">
      <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm text-slate-200 hover:bg-sidebar-hover">{{ nav.sign_out | default(value="Sign out") }}</button>
    </form>
  </div>
</aside>
