{% extends "layouts/application.html.tera" %}
{% block content %}
<section class="max-w-4xl">
  <h1 class="text-3xl font-bold text-white">{{ title }}</h1>
  <p class="mt-3 text-slate-400">{{ nav.dashboard | default(value="Welcome") }} — {{ app_name }}.</p>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <a href="/bank_accounts" class="rounded-xl border border-slate-800 bg-slate-900 p-5 hover:border-accent/50">
      <h2 class="font-bold text-accent">{{ nav.accounts | default(value="Bank accounts") }}</h2>
      <p class="mt-2 text-sm text-slate-400">{{ nav.new_account | default(value="Manage your accounts") }}</p>
    </a>
    {% if transactions_path %}
    <a href="{{ transactions_path }}" class="rounded-xl border border-slate-800 bg-slate-900 p-5 hover:border-accent/50">
      <h2 class="font-bold text-accent">{{ nav.transactions | default(value="Transactions") }}</h2>
      <p class="mt-2 text-sm text-slate-400">{{ nav.new_transaction | default(value="Track company spending") }}</p>
    </a>
    {% endif %}
  </div>
</section>
{% endblock %}
