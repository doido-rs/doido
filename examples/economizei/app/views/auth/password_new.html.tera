{% extends "layouts/auth.html.tera" %}
{% block content %}
<h1 class="text-2xl font-bold text-white">Reset password</h1>
{% if notice %}<p class="mt-4 rounded-lg border border-teal-900 bg-teal-950/40 px-3 py-2 text-sm text-teal-200">{{ notice }}</p>{% endif %}
<form method="post" action="/users/password" class="mt-6 space-y-4">
  <label class="block text-sm text-slate-300">Email
    <input type="email" name="email" required class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-white focus:border-accent focus:outline-none">
  </label>
  <button type="submit" class="w-full rounded-lg bg-accent px-4 py-2 font-bold text-slate-950 hover:opacity-90">Send reset instructions</button>
</form>
{% endblock %}
