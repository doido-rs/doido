//! User model extensions — implements [`UserModel`] for session and credential auth.
#![allow(dead_code)]

pub use super::_entities::users::*;

use doido::model::sea_orm::entity::prelude::*;
use doido::model::sea_orm::ActiveModelBehavior;

impl ActiveModelBehavior for ActiveModel {}

use doido::model::sea_orm::Set;
use doido::model::password::HasSecurePassword;
use doido_auth::user_model::{find_by_email_mapped, find_by_id_mapped, FetchPlan, UserRow};
use doido_auth::{RegisterableUserModel, UserModel, UserStore};

impl HasSecurePassword for Model {
    fn password_digest(&self) -> &str {
        &self.password_digest
    }
}

impl UserModel for Model {
    type Id = i64;

    fn from_row(row: UserRow) -> Result<Self, doido_auth::AuthError> {
        Ok(Self {
            id: row.id.and_then(|v| v.as_i64()).unwrap_or_default(),
            email: row.email.unwrap_or_default(),
            password_digest: row.password_digest.unwrap_or_default(),
            ..Default::default()
        })
    }

    fn id(&self) -> Self::Id {
        self.id
    }

    fn email(&self) -> &str {
        &self.email
    }

    fn password_digest(&self) -> Option<&str> {
        Some(&self.password_digest)
    }

    async fn find_by_email(
        store: &dyn UserStore,
        email: &str,
        plan: &FetchPlan,
    ) -> doido::Result<Option<Self>> {
        find_by_email_mapped::<Self>(store, email, plan)
            .await
            .map_err(Into::into)
    }

    async fn find_by_id(
        store: &dyn UserStore,
        id: Self::Id,
        plan: &FetchPlan,
    ) -> doido::Result<Option<Self>> {
        find_by_id_mapped::<Self>(store, id, plan)
            .await
            .map_err(Into::into)
    }

    async fn insert(_store: &dyn UserStore, row: UserRow) -> doido::Result<Self> {
        Self::from_row(row).map_err(Into::into)
    }
}

impl RegisterableUserModel for Model {
    async fn register(
        store: &dyn UserStore,
        email: String,
        password_digest: String,
    ) -> doido::Result<Self> {
        let Some(db) = store.sea_orm() else {
            return Err(doido_core::anyhow::anyhow!("user store has no SQL connection"));
        };
        let now = chrono::Utc::now();
        let record = ActiveModel {
            email: Set(email),
            password_digest: Set(password_digest),
            created_at: Set(now),
            updated_at: Set(now),
            ..Default::default()
        };
        record.insert(db).await.map_err(Into::into)
    }
}

impl Model {
    pub async fn find_by_email(
        _db: &DatabaseConnection,
        email: &str,
    ) -> doido::Result<Option<Self>> {
        let store = doido_auth::state::global().store.clone();
        <Self as UserModel>::find_by_email(store.as_ref(), email, &FetchPlan::minimal()).await
    }
}
