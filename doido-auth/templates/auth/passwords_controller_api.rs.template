use doido::controller::{controller, Context, Response};
use serde::Deserialize;

#[derive(Deserialize)]
pub struct PasswordResetForm {
    pub email: String,
}

#[derive(Deserialize)]
pub struct PasswordUpdateForm {
    pub password: String,
    pub password_confirmation: String,
    pub reset_token: String,
}

pub struct PasswordsController;

#[controller]
impl PasswordsController {
    /// POST /users/password
    pub async fn create(ctx: Context) -> doido::Result<Response> {
        let _form: PasswordResetForm = ctx.body_json().await?;
        Ok(ctx.status(202))
    }

    /// PATCH /users/password
    pub async fn update(mut ctx: Context) -> doido::Result<Response> {
        let _form: PasswordUpdateForm = ctx.body_json().await?;
        Ok(ctx.status(204))
    }
}
