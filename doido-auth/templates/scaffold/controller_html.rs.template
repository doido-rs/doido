use crate::models::{singular}::{ActiveModel, Column, Entity};
use crate::models::user::Model as User;
use doido::controller::{controller, Context, Response};
use doido::model::sea_orm::{entity::prelude::*, Set};
use doido_auth::{assign_current_user, current_user_id};
use serde::Deserialize;
use serde_json::json;

/// Strong params for creating/updating a {Model}.
#[derive(Deserialize)]
pub struct {Model}Form {
{params_fields}}

pub struct {Controller};

#[controller]
impl {Controller} {
    #[before_action(require_user)]
    #[before_action(load_current_user)]
    /// GET /{plural}
    pub async fn index(ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let {plural} = Entity::find()
            .filter(Column::UserId.eq(user.id))
            .all(ctx.db())
            .await?;
        Ok(ctx.render("{plural}/index", json!({ "{plural}": {plural} })))
    }

    #[before_action(require_user)]
    #[before_action(load_current_user)]
    /// GET /{plural}/{id}
    pub async fn show(ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let id = parse_id(&ctx);
        let {singular} = Entity::find_by_id(id)
            .filter(Column::UserId.eq(user.id))
            .one(ctx.db())
            .await?;
        Ok(ctx.render("{plural}/show", json!({ "{singular}": {singular} })))
    }

    #[before_action(require_user)]
    #[before_action(load_current_user)]
    /// GET /{plural}/new
    pub async fn new(ctx: Context) -> Response {
        ctx.render("{plural}/new", json!({}))
    }

    #[before_action(require_user)]
    /// POST /{plural}
    pub async fn create(mut ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let form: {Model}Form = ctx.form().await?;
        let record = ActiveModel {
            user_id: Set(user.id),
{active_model_sets}            ..Default::default()
        };
        record.insert(ctx.db()).await?;
        Ok(ctx.redirect_to("/{plural}"))
    }

    #[before_action(require_user)]
    #[before_action(load_current_user)]
    /// GET /{plural}/{id}/edit
    pub async fn edit(ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let id = parse_id(&ctx);
        let {singular} = Entity::find_by_id(id)
            .filter(Column::UserId.eq(user.id))
            .one(ctx.db())
            .await?;
        Ok(ctx.render("{plural}/edit", json!({ "{singular}": {singular} })))
    }

    #[before_action(require_user)]
    /// PATCH/PUT /{plural}/{id}
    pub async fn update(mut ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let id = parse_id(&ctx);
        let form: {Model}Form = ctx.form().await?;
        if let Some(existing) = Entity::find_by_id(id)
            .filter(Column::UserId.eq(user.id))
            .one(ctx.db())
            .await?
        {
            let mut record: ActiveModel = existing.into();
{active_model_assigns}            record.update(ctx.db()).await?;
        }
        Ok(ctx.redirect_to("/{plural}"))
    }

    #[before_action(require_user)]
    /// DELETE /{plural}/{id}
    pub async fn destroy(ctx: Context) -> doido::Result<Response> {
        let user = signed_in_user(ctx).await?;
        let id = parse_id(&ctx);
        Entity::delete_many()
            .filter(Column::UserId.eq(user.id))
            .filter(Column::Id.eq(id))
            .exec(ctx.db())
            .await?;
        Ok(ctx.redirect_to("/{plural}"))
    }
}

/// Parses the `:id` path segment, defaulting to 0 when absent/invalid.
fn parse_id(ctx: &Context) -> i32 {
    ctx.param("id").and_then(|v| v.parse().ok()).unwrap_or_default()
}

/// `before_action`: redirect anonymous visitors to the sign-in page. Resolves the
/// signed-in id from the identity or the session cookie (no database hit).
async fn require_user(ctx: &mut Context) -> Result<(), Response> {
    if current_user_id::<User>(ctx).is_some() {
        Ok(())
    } else {
        Err(ctx.redirect_to("/users/sign_in"))
    }
}

/// `before_action`: expose the signed-in user to views as `current_user` (plus a
/// `signed_in` flag), e.g. `{% if signed_in %}{{ current_user.email }}{% endif %}`.
async fn load_current_user(ctx: &mut Context) -> Result<(), Response> {
    assign_current_user::<User>(ctx).await;
    Ok(())
}

/// The signed-in user model (identity or session). `require_user` runs first, so
/// reaching an action implies an authenticated visitor. Takes `&mut Context` (not
/// `&Context`) so the returned future stays `Send` — axum's `Handler` bound
/// requires it, and `Context` is `Send` but not `Sync`.
async fn signed_in_user(ctx: &mut Context) -> doido::Result<User> {
    doido_auth::load_current_user::<User>(ctx)
        .await
        .ok_or_else(|| doido::core::anyhow::anyhow!("not signed in"))
}
